  "dependencies": {
    "@research/contracts": "0.1.0",
    "@research/experiment-core": "0.1.0",
    "express": "5.3.0",
    "@research/ai-orchestrator": "0.1.0",
    "@research/model-adapter": "0.1.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1"
  }
}
