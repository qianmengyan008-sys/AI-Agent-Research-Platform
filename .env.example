# Default development is offline; secrets belong in cloud environment settings.
MODEL_PROVIDER=mock
MODEL_API_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=512
MODEL_TIMEOUT_MS=10000
MODEL_MAX_ATTEMPTS=2
# Required only for live calls. Never commit a real value.
MODEL_API_KEY=

# Non-secret SHA-256 digest of a privately held high-entropy admin Bearer token.
# Unset disables administrator routes; never put the original token here.
ADMIN_ACCESS_TOKEN_HASH=
RESEARCH_CODE_COMMIT=development
# DATABASE_URL must be securely injected for an independent database.
# This application does not automatically load this example or run migrations.

# Optional read-only diagnostics; authenticated administrators only.
ADMIN_DEVELOPMENT_MODE=false
